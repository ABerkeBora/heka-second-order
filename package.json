{
  "name": "heka-second-order",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/server.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts",
    "test:contracts": "forge test",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.ts",
    "verify:live": "node --env-file-if-exists=.env scripts/live-evidence.ts",
    "test:recovery": "node scripts/recovery-test.mjs",
    "wallets:create": "node scripts/create-test-wallets.ts",
    "test:refund": "node scripts/unmatched-refund-test.mjs",
    "test:namespace": "node scripts/namespace-test.mjs",
    "test:next-gates": "node scripts/next-gates-test.mjs",
    "verify:next-policy": "node --env-file-if-exists=.env scripts/verify-next-policy.ts",
    "verify:next-isolation": "node --env-file-if-exists=.env scripts/verify-next-isolation.ts",
    "test:bsv": "node --test src/bsv-script.test.ts",
    "verify:bsv": "node --env-file-if-exists=.env scripts/bsv-tamper.ts",
    "refund:bsv": "node scripts/bsv-refund.ts",
    "test:bsv-native-gates": "node scripts/bsv-native-gates.mjs",
    "test:bsv-native-sdk": "cd native && node pm-followon/test-sdk.cjs"
  },
  "dependencies": {
    "@bsv/sdk": "3.2.1",
    "@bsv/wallet-toolbox": "2.14.9",
    "express": "5.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "second-order-native-consumer": "file:native",
    "viem": "2.57.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
