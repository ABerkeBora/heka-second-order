
library KeccakOneBlock {
  static const int MASK = 18446744073709551615;
  static const int[25] ROT = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14];
  static const int[24] RC = [0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000, 0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009, 0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a, 0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003, 0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a, 0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008];
  static function rot(int v, int n) : int {
    return ((v << n) & 18446744073709551615) + (v >> 64 - n);
  }
  static function digest(bytes input) : bytes {
    int size = len(input);
    require(size <= 135);
    bytes padded = b'';
    if(size == 135) {
        padded = input + b'81';
      } else {
        padded = input + b'01' + Utils.toLEUnsigned(0, 134 - size) + b'80';
      }
    int[25] a = repeat(0, 25);
    loop (17) : i {
        a[i] = Utils.fromLEUnsigned(padded[(i) * 8 : (i + 1) * 8]);
      }
    loop (24) : round {
        int[5] c = repeat(0, 5);
        int[5] d = repeat(0, 5);
        loop (5) : x {
          c[x] = ((((a[x] ^ a[x + 5]) ^ a[x + 10]) ^ a[x + 15]) ^ a[x + 20]);
        }
        loop (5) : x {
          d[x] = (c[(x + 4) % 5] ^ KeccakOneBlock.rot(c[(x + 1) % 5], 1));
        }
        loop (5) : y {
          loop (5) : x {
            a[x + 5 * y] = (a[x + 5 * y] ^ d[x]);
          }
        }
        int[25] b = repeat(0, 25);
        loop (5) : y {
          loop (5) : x {
            b[y + 5 * ((2 * x + 3 * y) % 5)] = KeccakOneBlock.rot(a[x + 5 * y], KeccakOneBlock.ROT[x + 5 * y]);
          }
        }
        loop (5) : y {
          loop (5) : x {
            a[x + 5 * y] = (b[x + 5 * y] ^ ((18446744073709551615 ^ b[(x + 1) % 5 + 5 * y]) & b[(x + 2) % 5 + 5 * y]));
          }
        }
        a[0] = (a[0] ^ KeccakOneBlock.RC[round]);
      }
    return Utils.toLEUnsigned(a[0], 8) + Utils.toLEUnsigned(a[1], 8) + Utils.toLEUnsigned(a[2], 8) + Utils.toLEUnsigned(a[3], 8);
  }
}

contract KeccakTest {
  bytes expected;
  public function unlock(bytes input) {
    require(KeccakOneBlock.digest(input) == this.expected);
  }
}